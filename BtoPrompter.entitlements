<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Micrófono: necesario para el seguimiento por voz. Con el runtime
	     reforzado, sin este permiso macOS deniega el acceso sin preguntar. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Eventos de otras apps: avanzar diapositivas en Keynote y PowerPoint. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
